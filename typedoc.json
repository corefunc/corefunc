{
  "blockTags": [
    "@category",
    "@deprecated",
    "@description",
    "@example",
    "@name",
    "@param",
    "@returns",
    "@see",
    "@since",
    "@summary",
    "@template",
    "@throws",
    "@url"
  ],
  "categorizeByGroup": true,
  "entryPoints": [
    "./array/index.ts",
    "./cast/index.ts",
    "./check/index.ts",
    "./cli/index.ts",
    "./collection/index.ts",
    "./convert/index.ts",
    "./crypt/index.ts",
    "./date/index.ts",
    "./fp/index.ts",
    "./func/index.ts",
    "./generate/index.ts",
    "./hash/index.ts",
    "./high-order/index.ts",
    "./is/index.ts",
    "./json/index.ts",
    "./lang/index.ts",
    "./number/index.ts",
    "./object/index.ts",
    "./promise/index.ts",
    "./prototype/index.ts",
    "./regex/index.ts",
    "./string/index.ts",
    "./text/index.ts",
    "./time/index.ts",
    "./valid/index.ts",
    "./var/index.ts"
  ],
  "exclude": ["**/*+(index|.spec|.e2e).ts"],
  "excludeExternals": true,
  "externalPattern": ["**/node_modules/**"],
  "out": "docs",
  "plugin": ["typedoc-rhineai-theme"],
  "theme": "typedoc-rhineai-theme"
}
