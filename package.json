{
  "author": "Anton Trofymenko",
  "bugs": {
    "url": "https://github.com/corefunc/corefunc/issues"
  },
  "contributors": [
    {
      "name": "Anton Trofymenko"
    }
  ],
  "description": "Collection of utilities",
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.2",
    "@types/node": "25.2.0",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.5.0",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "typedoc": "0.28.16",
    "typedoc-material-theme": "1.4.1",
    "typedoc-rhineai-theme": "1.2.0",
    "typescript": "5.9.3"
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=8.12.0"
  },
  "engineStrict": false,
  "keywords": [
    "ECMAScript",
    "es6,",
    "modules",
    "stdlib,",
    "util,",
    "utilities"
  ],
  "license": "MIT",
  "name": "@corefunc/corefunc",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corefunc/corefunc.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cleanup": "node ./cleanup.mjs",
    "doc": "typedoc --options typedoc.json --plugin typedoc-rhineai-theme",
    "lint": "eslint . --ext .ts",
    "package:audit": "npm audit --json | npx npm-audit-html",
    "package:check": "npx depcheck",
    "package:upgrade": "npx npm-check --update",
    "prepublishOnly": "npm run build && npm test",
    "test": "node ./test/index.test.js",
    "test:node": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "types": "./index.d.ts",
  "type": "module",
  "version": "1.0.0"
}
